# 이 파일을 복사해서 .env 로 만들고 값을 채우세요.   (.env 는 절대 깃에 올리지 않기 — .gitignore 에 등록됨)
# Render 에서는 .env 대신 서비스 > Environment 탭에 같은 이름으로 등록합니다.

# --- DB ---------------------------------------------------------------
# 비워두면 프로젝트 루트의 noiseai.db (SQLite) 를 씁니다. 로컬 개발은 비워둬도 됩니다.
# PostgreSQL (Neon / Supabase / Render 모두 이 형태):  postgresql://사용자:비밀번호@호스트/DB이름?sslmode=require
# MySQL:                                                mysql://사용자:비밀번호@호스트/DB이름
DATABASE_URL=

# --- Replicate (음악 생성) --------------------------------------------
# https://replicate.com/account/api-tokens 에서 발급 (r8_ 로 시작)
REPLICATE_API_TOKEN=
# 모델 페이지(replicate.com/meta/musicgen) > API 탭에서 최신 버전 해시 확인 후 바꿀 수 있음. 비우면 기본값 사용
REPLICATE_MODEL_VERSION=
TRACK_DURATION=30        # 초 (meta/musicgen 최대 30)
TRACK_FORMAT=mp3         # mp3 또는 wav
POLL_INTERVAL=3          # 상태 확인 간격(초)
POLL_TIMEOUT=240         # 이 시간 넘으면 포기하고 작업 취소(초)

# --- 음원 저장 --------------------------------------------------------
DOWNLOAD_AUDIO=true      # Replicate 링크는 약 1시간 뒤 삭제되므로 true 권장
PUBLIC_BASE_URL=         # 예: https://noiseai.onrender.com  (비우면 /media/... 상대경로로 응답)

# --- 기타 -------------------------------------------------------------
CORS_ORIGINS=*           # 프론트 배포 후에는 https://프론트주소 처럼 콤마로 구분해서 제한
PROMPT_STRATEGY=match    # match: 시끄러우면 신나는 곡 / calm: 시끄러우면 차분한 곡
